# URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: swap the satellite imagery provider. Defaults to Esri World Imagery (no key needed).
# NEXT_PUBLIC_TILE_URL=https://example.com/tiles/{z}/{x}/{y}.jpg
# NEXT_PUBLIC_TILE_ATTRIBUTION=Imagery &copy; Your provider
# NEXT_PUBLIC_TILE_MAX_ZOOM=19
